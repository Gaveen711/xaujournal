{
  "name": "xaujournal",
  "description": "xaujournal — Pro Trade Intelligence Terminal",
  "author": "Gaveen Perera",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "node scripts/dev-admin.mjs",
    "dev:api": "node scripts/dev-admin-api.mjs",
    "build": "vite build",
    "build:budget": "vite build && node scripts/check-bundle-budget.mjs",
    "migrate:performance": "node scripts/migrate-performance-data.mjs",
    "migrate:performance:apply": "node scripts/migrate-performance-data.mjs --apply",
