    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vercel": "^65.4.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
