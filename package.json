    "migrate:broker-privacy:apply": "node scripts/migrate-broker-credential-privacy.mjs --apply",
    "admin:grant": "node scripts/grant-admin.mjs",
    "admin:list": "node scripts/grant-admin.mjs --list",
    "admin:dev": "npm --prefix admin-dashboard run dev",
    "admin:build": "npm --prefix admin-dashboard run build",
    "deploy": "node scripts/deploy-both.mjs --prod",
    "deploy:all": "node scripts/deploy-both.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p api --noEmit",
    "preview": "vite preview",
    "shots": "node scripts/capture-shots.mjs",
    "shots:og": "node scripts/build-og.mjs",
    "test": "vitest run"
  },
